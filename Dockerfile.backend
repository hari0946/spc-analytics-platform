# Backend image for platforms that build from the repository root (e.g. Railway).
# For docker compose use backend/Dockerfile.
FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 MPLBACKEND=Agg
WORKDIR /app
COPY backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY backend/app ./app
COPY backend/sql ./sql
COPY backend/scripts ./scripts
RUN useradd --system --uid 10001 spc && chown -R spc /app
USER spc
EXPOSE 8000
# listens on IPv4 and IPv6 (Railway private networking may use either)
CMD ["python", "-m", "app.serve"]
