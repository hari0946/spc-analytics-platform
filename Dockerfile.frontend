# Frontend image for platforms that build from the repository root (e.g. Railway).
# For docker compose use frontend/Dockerfile.
FROM node:22-alpine AS build
WORKDIR /app
COPY frontend/package*.json ./
RUN npm ci
COPY frontend/ .
RUN npm run build

FROM nginx:1.27-alpine
# nginx fills these in at start-up (official image: /etc/nginx/templates/*.template)
ENV PORT=80 BACKEND_URL=http://backend:8000 RESOLVER=127.0.0.11
COPY frontend/nginx.conf.template /etc/nginx/templates/default.conf.template
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
