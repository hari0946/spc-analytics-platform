server {
  listen ${PORT};
  listen [::]:${PORT};
  server_name _;
  root /usr/share/nginx/html;
  client_max_body_size 210m;          # uploads up to MAX_UPLOAD_MB

  add_header X-Content-Type-Options nosniff always;
  add_header X-Frame-Options DENY always;
  add_header Referrer-Policy no-referrer always;

  # Names are resolved per request, so nginx starts even if the backend is not up yet.
  resolver ${RESOLVER} valid=10s ipv6=on;

  location /api/ {
    set $upstream ${BACKEND_URL};
    proxy_pass $upstream;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
    proxy_read_timeout 300s;
    proxy_send_timeout 300s;
  }
  location /health {
    set $upstream ${BACKEND_URL};
    proxy_pass $upstream;
  }
  location / {
    try_files $uri /index.html;       # single-page app routes
  }
}
